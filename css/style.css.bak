/* ═══════════════════════════════════════════════
   FARAH 2026 — Design System
   Modern RTL · Mesh Gradients · Bento Grid
   ═══════════════════════════════════════════════ */

@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&family=Tajawal:wght@300;400;500;700;800&display=swap');

/* ── Variables ── */
:root {
  /* Light Palette */
  --navy:          #111111;
  --navy-mid:      #222222;
  --navy-light:    #333333;
  --gold:          #D89A83;
  --gold-light:    #F0C5B5;
  --gold-dark:     #B07661;
  --cream:         #FBFBFB;
  --cream-2:       #F2F2F5;
  --white:         #FFFFFF;
  --flash-bg:      #000000;
  --flash-accent:  #E63946;

  /* Mesh orb colors */
  --orb1: #D89A8322;
  --orb2: #1111110A;
  --orb3: #F0C5B51A;
  --orb4: #E6394605;

  /* Text - Light Mode */
  --text-dark:     #111111;
  --text-mid:      #4A4A4A;
  --text-soft:     #888888;
  --text-white:    #FFFFFF;

  /* Glass Effects - Light */
  --glass-bg: rgba(255, 255, 255, 0.6);
  --glass-border: rgba(255, 255, 255, 0.8);
  --glass-shadow: rgba(0,0,0,0.03);
  --glass-shadow-hover: rgba(0,0,0,0.08);
  --glass-nav: rgba(251,251,251,0.85);
  --glass-nav-border: rgba(17,17,17,0.05);
  
  --flash-card-bg: #fff;
  --flash-timer-bg: var(--navy);
  --flash-timer-text: #fff;
  --flash-timer-sep: var(--navy);
  --flash-discount-bg: #FFF0E8;
  --flash-discount-text: var(--flash-accent);
}

[data-theme="dark"] {
  /* Dark Palette */
  --navy:          #FBFBFB; /* Inverted for light text accents */
  --navy-mid:      #E0E0E0;
  --navy-light:    #C0C0C0;
  --gold:          #D89A83;
  --gold-light:    #F0C5B5;
  --gold-dark:     #B07661;
  --cream:         #0a0a0a; /* True black background */
  --cream-2:       #151515; /* Slightly lighter for cards */
  --white:         #1a1a1a; /* Replaced white with dark grey for contrast */
  --flash-bg:      #E63946;
  --flash-accent:  #ffffff;

  /* Mesh orb colors - adjusted for dark mode */
  --orb1: rgba(216, 154, 131, 0.15);
  --orb2: rgba(255, 255, 255, 0.03);
  --orb3: rgba(240, 197, 181, 0.1);
  --orb4: rgba(230, 57, 70, 0.05);

  /* Text - Dark Mode */
  --text-dark:     #FBFBFB;
  --text-mid:      #B0B0B0;
  --text-soft:     #888888;
  --text-white:    #FFFFFF;

  /* Glass Effects - Dark */
  --glass-bg: rgba(25, 25, 25, 0.6);
  --glass-border: rgba(255, 255, 255, 0.08);
  --glass-shadow: rgba(0,0,0,0.4);
  --glass-shadow-hover: rgba(0,0,0,0.6);
  --glass-nav: rgba(10, 10, 10, 0.85);
  --glass-nav-border: rgba(255, 255, 255, 0.05);

  --flash-card-bg: rgba(20, 20, 20, 0.8);
  --flash-timer-bg: rgba(255, 255, 255, 0.1);
  --flash-timer-text: #fff;
  --flash-timer-sep: rgba(255,255,255,0.5);
  --flash-discount-bg: rgba(230, 57, 70, 0.2);
  --flash-discount-text: #ff6b6b;
}

  /* Radius */
  --r-sm:   10px;
  --r-md:   18px;
  --r-lg:   26px;
  --r-xl:   38px;
  --r-full: 999px;

  /* Shadows */
  --shadow-xs: 0 1px 4px rgba(11,25,41,.06);
  --shadow-sm: 0 4px 16px rgba(11,25,41,.09);
  --shadow-md: 0 12px 32px rgba(17,17,17,0.08);
  --shadow-lg: 0 24px 64px rgba(17,17,17,0.12);
  --shadow-gold: 0 8px 32px rgba(200,168,75,.28);

  /* Motion */
  --ease: cubic-bezier(0.25, 1, 0.5, 1);
  --ease-out:  cubic-bezier(0,.55,.45,1);
  --ease-spring: cubic-bezier(.34,1.56,.64,1);
  --t-fast:    150ms;
  --t-base:    280ms;
  --t-slow:    500ms;

  /* Font */
  --font: 'Cairo', 'Tajawal', system-ui, sans-serif;

  /* Layout */
  --max-w: 1280px;
  --nav-h: 68px;
  --top-h: 36px;
}

/* ── Reset ── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  font-family:var(--font);
  background:var(--cream);
  color:var(--text-dark);
  direction:rtl;
  overflow-x:hidden;
  line-height:1.7;
}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block;object-fit:cover}
button{cursor:pointer;font-family:var(--font);border:none;background:none;padding:0}
ul{list-style:none}
input,select,textarea{font-family:var(--font)}

/* ── Containers ── */
.wide-container{width:min(var(--max-w),94%);margin-inline:auto}

/* ── Buttons ── */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:13px 28px;border-radius:var(--r-full);
  font-size:.9rem;font-weight:700;font-family:var(--font);
  transition:transform var(--t-base) var(--ease),
             box-shadow var(--t-base) var(--ease),
             background var(--t-base) var(--ease);
  cursor:pointer;border:none;white-space:nowrap;
}
.btn:hover{transform:translateY(-2px)}
.btn:active{transform:translateY(0)}

.btn-gold{
  background:linear-gradient(135deg,var(--gold-light),var(--gold));
  color:var(--navy);
  box-shadow:var(--shadow-gold);
}
.btn-gold:hover{box-shadow:0 12px 40px rgba(200,168,75,.4);background:linear-gradient(135deg,#f0d68a,var(--gold-light))}

.btn-glass{
  background:rgba(255,255,255,.15);
  border:1.5px solid rgba(255,255,255,.3);
  color:#fff;
  backdrop-filter:blur(12px);
}
.btn-glass:hover{background:rgba(255,255,255,.22)}

.btn-outline-dark{
  background:transparent;
  border:2px solid var(--navy);
  color:var(--navy);
  padding:12px 36px;
}
.btn-outline-dark:hover{background:var(--navy);color:#fff}

.btn-ghost{background:var(--cream-2);color:var(--text-mid);border:1.5px solid #e0d9cc}
.btn-ghost:hover{background:#e8e3d8}

.w-full{width:100%;justify-content:center}

/* ═══════════════════════════════════════════════
   TOPBAR — Scrolling ticker
═══════════════════════════════════════════════ */
.topbar{
  background:var(--navy);
  height:var(--top-h);
  overflow:hidden;
  position:fixed;top:0;inset-inline:0;
  z-index:1001;
}
.topbar-track{
  display:flex;align-items:center;gap:2.5rem;
  height:100%;
  white-space:nowrap;
  animation:ticker 22s linear infinite;
  color:rgba(255,255,255,.75);
  font-size:.78rem;font-weight:500;
  padding:0 2rem;
}
.topbar-sep{color:var(--gold);font-size:.6rem}
@keyframes ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ═══════════════════════════════════════════════
   NAVBAR
═══════════════════════════════════════════════/* ── Header ── */
.navbar{
  position:fixed;top:0;width:100%;height:var(--nav-h);
  background:var(--glass-nav);
  backdrop-filter:blur(24px);
  -webkit-backdrop-filter:blur(24px);
  border-bottom:1px solid var(--glass-nav-border);
  z-index:900;
  display:flex;align-items:center;
  transition:all var(--t-base) var(--ease);
}
.navbar.scrolled{
  background:rgba(250,247,242,.98);
  box-shadow:0 4px 24px rgba(11,25,41,.08);
}
.nav-container{
  display:flex;align-items:center;justify-content:space-between;
  height:var(--nav-h);
  width:min(var(--max-w),96%);
  margin-inline:auto;
  gap:1.5rem;
}
.nav-logo{display:flex;flex-direction:column;line-height:1;flex-shrink:0;gap:1px}
.logo-ar{font-size:1.35rem;font-weight:900;color:var(--navy);letter-spacing:-.02em}
.logo-en{font-size:.55rem;font-weight:800;color:var(--gold);letter-spacing:.28em;text-transform:uppercase}

.nav-links{
  display:flex;align-items:center;gap:2px;
}
.nav-links a{
  padding:7px 14px;border-radius:var(--r-full);
  font-weight:600;font-size:.88rem;color:var(--text-mid);
  transition:color var(--t-fast),background var(--t-fast);
  white-space:nowrap;
}
.nav-links a:hover{color:var(--navy);background:var(--cream-2)}

.nav-actions{display:flex;align-items:center;gap:6px}
.nav-icon-btn{
  width:42px;height:42px;
  display:flex;align-items:center;justify-content:center;
  border-radius:var(--r-full);
  transition:background var(--t-fast),transform var(--t-fast);
  position:relative;
}
.nav-icon-btn:hover{background:var(--cream-2);transform:scale(1.08)}
.nav-cart-btn svg{stroke:var(--navy)}

.cart-badge{
  position:absolute;top:4px;left:4px;
  background:var(--gold);color:var(--navy);
  font-size:.62rem;font-weight:900;
  width:17px;height:17px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  transition:transform var(--ease-spring) var(--t-base),opacity var(--t-base);
  transform:scale(1);
}
.cart-badge[data-hidden]{opacity:0;transform:scale(0)}

/* Hamburger */
.hamburger{display:none;flex-direction:column;gap:5px;padding:8px;border-radius:8px}
.hamburger span{width:22px;height:2px;background:var(--navy);border-radius:2px;transition:var(--t-base) var(--ease)}
.hamburger.open span:nth-child(1){transform:rotate(45deg) translate(5px,5px)}
.hamburger.open span:nth-child(2){opacity:0;transform:scaleX(0)}
.hamburger.open span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px)}

/* ── Search Overlay ── */
.search-overlay{
  position:fixed;
  top:calc(var(--top-h) + var(--nav-h));
  inset-inline:0;
  background:rgba(250,247,242,.97);
  backdrop-filter:blur(20px);
  z-index:999;
  padding:1.25rem 0;
  border-bottom:1px solid var(--cream-2);
  transform:translateY(-100%);
  opacity:0;
  pointer-events:none;
  transition:transform var(--t-base) var(--ease),opacity var(--t-base);
}
.search-overlay.open{transform:none;opacity:1;pointer-events:all}
.search-overlay-inner{
  display:flex;align-items:center;gap:12px;
  width:min(800px,94%);margin-inline:auto;
}
.search-overlay-input{
  flex:1;padding:13px 20px;
  border:2px solid rgba(200,168,75,.3);
  border-radius:var(--r-full);
  background:var(--white);
  font-size:1rem;outline:none;
  transition:border-color var(--t-fast);
}
.search-overlay-input:focus{border-color:var(--gold)}
.search-close{color:var(--text-soft);transition:color var(--t-fast)}
.search-close:hover{color:var(--navy)}
.search-results{
  width:min(800px,94%);margin:1rem auto 0;
  display:flex;gap:12px;flex-wrap:wrap;
}

/* ── Mobile Nav ── */
.mobile-nav-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.5);
  z-index:1099;opacity:0;pointer-events:none;
  transition:opacity var(--t-base);backdrop-filter:blur(4px);
}
.mobile-nav-overlay.open{opacity:1;pointer-events:all}
.mobile-nav{
  position:fixed;top:0;right:0;
  width:min(320px,85vw);height:100%;
  background:var(--white);z-index:1100;
  transform:translateX(100%);
  transition:transform var(--t-slow) var(--ease);
  display:flex;flex-direction:column;
  box-shadow:var(--shadow-lg);
}
.mobile-nav.open{transform:none}
.mobile-nav-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:1.5rem;border-bottom:1px solid var(--cream-2);
}
.mobile-nav-links{display:flex;flex-direction:column;padding:1rem}
.mobile-nav-links a{
  padding:1rem 1.25rem;border-radius:var(--r-md);
  font-weight:700;font-size:1rem;
  color:var(--text-dark);
  transition:background var(--t-fast);
  margin-bottom:4px;
}
.mobile-nav-links a:hover{background:var(--cream-2)}

/* ═══════════════════════════════════════════════
   BENTO SECTION
═══════════════════════════════════════════════ */
.bento-section{
  padding-top:calc(var(--top-h) + var(--nav-h) + 2rem);
  padding-bottom:4rem;
  position:relative;
  overflow:hidden;
  min-height:100dvh;
}

/* Mesh gradient background */
.mesh-bg{
  position:absolute;inset:0;z-index:0;
  pointer-events:none;
}
.mesh-orb{
  position:absolute;
  border-radius:50%;
  filter:blur(80px);
  pointer-events:none;
}
.orb1{width:600px;height:600px;top:-20%;right:-10%;background:radial-gradient(circle,var(--orb1),transparent 70%)}
.orb2{width:500px;height:500px;bottom:-10%;left:-5%;background:radial-gradient(circle,var(--orb2),transparent 70%)}
.orb3{width:400px;height:400px;top:30%;left:30%;background:radial-gradient(circle,var(--orb3),transparent 70%)}
.orb4{width:350px;height:350px;bottom:20%;right:20%;background:radial-gradient(circle,var(--orb4),transparent 70%)}

.bento-container{
  position:relative;z-index:1;
  width:min(var(--max-w),96%);margin-inline:auto;
  display:grid;
  grid-template-columns:repeat(12,1fr);
  grid-template-rows:auto;
  gap:1rem;
}

/* ── Card base ── */
.bento-card{
  border-radius:var(--r-lg);
  overflow:hidden;
  position:relative;
  transition:transform var(--t-base) var(--ease),
             box-shadow var(--t-base) var(--ease);
}
.bento-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}

/* ── A: Brand ── */
.bento-brand{
  grid-column:span 5;
  grid-row:span 2;
  background:linear-gradient(145deg,var(--navy) 0%,#0F2847 50%,#0E1E3A 100%);
  padding:2.5rem;
  display:flex;align-items:flex-end;
  min-height:500px;
}
.bento-brand-inner{position:relative;z-index:2}
.bento-brand-deco{
  position:absolute;inset:0;pointer-events:none;overflow:hidden;
}
.deco-circle{
  position:absolute;border-radius:50%;
  border:1px solid rgba(200,168,75,.2);
}
.deco-circle.c1{width:300px;height:300px;top:-80px;left:-80px}
.deco-circle.c2{width:200px;height:200px;top:10px;left:-10px;border-color:rgba(200,168,75,.1)}
.deco-circle.c3{width:120px;height:120px;bottom:60px;right:-30px;background:rgba(200,168,75,.04)}

.bento-pill{
  display:inline-flex;align-items:center;gap:6px;
  background:rgba(200,168,75,.15);
  border:1px solid rgba(200,168,75,.3);
  color:var(--gold-light);
  font-size:.75rem;font-weight:700;
  padding:5px 14px;border-radius:var(--r-full);
  margin-bottom:1.25rem;
  letter-spacing:.06em;
}
.bento-brand-title{
  font-size:clamp(2.2rem,5vw,3.8rem);
  font-weight:900;
  color:#fff;
  line-height:1.1;
  margin-bottom:1rem;
}
.bento-brand-title em{
  font-style:normal;
  background:linear-gradient(135deg,var(--gold-light),var(--gold));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;
}
.bento-brand-sub{
  color:rgba(255,255,255,.6);
  font-size:.95rem;
  margin-bottom:1.75rem;
  line-height:1.6;
}
.bento-brand-actions{display:flex;gap:10px;flex-wrap:wrap}

/* ── B: Product Hero ── */
.bento-product-hero{
  grid-column:span 4;
  grid-row:span 2;
  min-height:500px;
  cursor:pointer;
}
.bento-img-wrap{position:absolute;inset:0}
.bento-img{width:100%;height:100%;object-fit:cover;transition:transform var(--t-slow) var(--ease)}
.bento-card:hover .bento-img{transform:scale(1.04)}
.bento-img-overlay{
  position:absolute;inset:0;
  background:linear-gradient(to top,rgba(11,25,41,.85) 0%,transparent 55%);
}
.bento-product-info{
  position:absolute;bottom:0;left:0;right:0;
  padding:1.5rem;z-index:2;
}
.bento-cat-tag{
  display:inline-block;
  background:rgba(200,168,75,.9);
  color:var(--navy);
  font-size:.7rem;font-weight:800;
  padding:3px 10px;border-radius:var(--r-full);
  margin-bottom:.5rem;
}
.bento-product-info h2{
  color:#fff;font-size:1.1rem;font-weight:800;
  line-height:1.3;margin-bottom:.5rem;
}
.bento-price-row{display:flex;align-items:center;gap:8px}
.bento-price{color:var(--gold-light);font-size:1.1rem;font-weight:900}
.bento-price-old{color:rgba(255,255,255,.45);font-size:.82rem;text-decoration:line-through}

.bento-quick-add{
  position:absolute;top:12px;left:12px;z-index:3;
  width:38px;height:38px;border-radius:50%;
  background:rgba(255,255,255,.9);
  backdrop-filter:blur(8px);
  display:flex;align-items:center;justify-content:center;
  transition:transform var(--ease-spring) var(--t-base),background var(--t-fast);
  box-shadow:var(--shadow-sm);
}
.bento-quick-add:hover{transform:scale(1.2) rotate(90deg);background:var(--gold)}
.bento-quick-add svg{stroke:var(--navy);transition:stroke var(--t-fast)}

/* ── C: Flash ── */
.bento-flash{
  grid-column:span 3;
  background:var(--flash-card-bg);
  border:1px solid var(--glass-border);
  box-shadow:var(--shadow-sm);
  display:flex;flex-direction:column;
}
.bento-flash-badge{
  position:absolute;top:12px;right:12px;z-index:3;
  background:var(--flash-accent);color:#fff;
  font-size:.7rem;font-weight:800;
  padding:4px 10px;border-radius:var(--r-full);
}
.bento-flash-img-wrap{height:160px;position:relative;overflow:hidden}
.bento-flash-content{padding:1rem;flex:1;display:flex;flex-direction:column;gap:.5rem}
.flash-timer{
  display:flex;align-items:center;gap:4px;
}
.timer-block{
  background:var(--flash-timer-bg);color:var(--flash-timer-text);
  border-radius:6px;padding:4px 6px;
  text-align:center;min-width:36px;
}
.timer-block span{display:block;font-size:.9rem;font-weight:800;line-height:1}
.timer-block small{font-size:.55rem;opacity:.6}
.timer-sep{color:var(--flash-timer-sep);font-weight:900;font-size:.9rem}
.bento-flash-name{font-weight:700;font-size:.9rem;color:var(--text-dark)}
.bento-flash-prices{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.flash-price-new{font-size:1.1rem;font-weight:900;color:var(--text-dark)}
.flash-price-old{font-size:.8rem;color:var(--text-soft);text-decoration:line-through}
.flash-discount{background:var(--flash-discount-bg);color:var(--flash-discount-text);font-size:.7rem;font-weight:800;padding:2px 8px;border-radius:var(--r-full)}

/* ── D: Stats ── */
.bento-stats{
  grid-column:span 3;
  background:linear-gradient(135deg,var(--gold),var(--gold-dark));
  display:flex;align-items:center;justify-content:space-around;
  padding:1.25rem 1rem;
}
.bento-stat{text-align:center}
.bento-stat strong{display:block;font-size:1.5rem;font-weight:900;color:var(--navy)}
.bento-stat span{font-size:.72rem;font-weight:600;color:rgba(11,25,41,.65)}
.bento-stat-div{width:1px;height:36px;background:rgba(11,25,41,.15)}

/* ── E,F: Small product cards ── */
.bento-product-sm{
  grid-column:span 3;
  min-height:180px;
  cursor:pointer;
}
.bento-sm-info{
  position:absolute;bottom:0;left:0;right:0;
  padding:1rem;z-index:2;
  display:flex;justify-content:space-between;align-items:flex-end;
}
.bento-sm-info span:first-child{color:#fff;font-size:.85rem;font-weight:700}
.bento-sm-price{color:var(--gold-light);font-weight:900;font-size:.9rem}

/* ── G: Trust ── */
.bento-trust{
  grid-column:span 5;
  background:var(--white);
  border:1.5px solid var(--cream-2);
  display:flex;align-items:center;justify-content:space-around;
  padding:1.25rem;
  box-shadow:var(--shadow-xs);
}
.trust-item{display:flex;align-items:center;gap:8px;font-size:.82rem;font-weight:700;color:var(--text-mid)}
.trust-icon{font-size:1.3rem}

/* Section labels */
.section-eyebrow{
  font-size:.78rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  color:var(--gold-dark);margin-bottom:.5rem;
}
.section-heading{
  font-size:clamp(1.5rem,3.5vw,2.2rem);
  font-weight:900;color:var(--navy);
  line-height:1.25;
}

/* ═══════════════════════════════════════════════
   NEW ARRIVALS — Horizontal scroll strip
═══════════════════════════════════════════════ */
.strip-section{
  padding:4rem 0 2rem;
  background:var(--white);
}
.strip-header{
  display:flex;align-items:flex-end;justify-content:space-between;
  width:min(var(--max-w),96%);margin-inline:auto;
  margin-bottom:1.5rem;
}
.strip-scroll-btn{
  width:42px;height:42px;
  border-radius:50%;
  border:2px solid var(--cream-2);
  display:flex;align-items:center;justify-content:center;
  color:var(--navy);
  transition:background var(--t-fast),border-color var(--t-fast);
}
.strip-scroll-btn:hover{background:var(--cream-2)}

.h-scroll-track{
  display:flex;gap:1rem;
  overflow-x:auto;scroll-snap-type:x mandatory;
  padding:0.5rem min(calc((100vw - var(--max-w))/2 + 2%), 3%);
  padding-bottom:1rem;
  scrollbar-width:none;
}
.h-scroll-track::-webkit-scrollbar{display:none}

/* ── Product Card (universal) ── */
.prod-card{
  flex-shrink:0;
  width:240px;
  background:var(--white);
  border-radius:var(--r-md);
  overflow:hidden;
  border:1.5px solid var(--cream-2);
  scroll-snap-align:start;
  transition:transform var(--t-base) var(--ease),
             border-color var(--t-base),
             box-shadow var(--t-base) var(--ease);
  cursor:pointer;
  position:relative;
}
.prod-card:hover{
  transform:translateY(-6px);
  border-color:rgba(200,168,75,.5);
  box-shadow:var(--shadow-md);
}
.prod-card-img{
  height:220px;overflow:hidden;
  background:var(--cream);
  position:relative;
}
.prod-card-img img{
  width:100%;height:100%;
  object-fit:cover;
  transition:transform var(--t-slow) var(--ease);
}
.prod-card:hover .prod-card-img img{transform:scale(1.06)}

.prod-card-badge{
  position:absolute;top:10px;right:10px;
  font-size:.65rem;font-weight:800;
  padding:3px 10px;border-radius:var(--r-full);
  z-index:2;
}
.badge-sale{background:#FF4757;color:#fff}
.badge-new{background:var(--navy);color:#fff}
.badge-hot{background:linear-gradient(135deg,#FF6B35,#FFB347);color:var(--navy)}

.prod-card-actions{
  position:absolute;top:10px;left:10px;
  display:flex;flex-direction:column;gap:6px;
  z-index:2;
  opacity:0;transform:translateX(-8px);
  transition:opacity var(--t-base),transform var(--t-base);
}
.prod-card:hover .prod-card-actions{opacity:1;transform:none}
.prod-action-btn{
  width:34px;height:34px;
  background:rgba(255,255,255,.9);backdrop-filter:blur(8px);
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  box-shadow:var(--shadow-xs);
  transition:transform var(--ease-spring) var(--t-base),background var(--t-fast);
  font-size:.9rem;
}
.prod-action-btn:hover{transform:scale(1.15);background:var(--gold)}

.prod-card-body{padding:1rem}
.prod-card-cat{font-size:.68rem;font-weight:700;color:var(--gold-dark);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.3rem}
.prod-card-name{font-size:.92rem;font-weight:700;color:var(--navy);line-height:1.35;margin-bottom:.6rem}
.prod-card-stars{color:var(--gold);font-size:.78rem;margin-bottom:.6rem;display:flex;align-items:center;gap:4px}
.prod-card-stars span{color:var(--text-soft);font-size:.72rem}
.prod-card-footer{display:flex;align-items:center;justify-content:space-between}
.prod-card-price{display:flex;flex-direction:column}
.prod-price-now{font-size:1rem;font-weight:900;color:var(--navy)}
.prod-price-was{font-size:.75rem;color:var(--text-soft);text-decoration:line-through}
.prod-add-btn{
  width:36px;height:36px;
  background:var(--navy);color:#fff;
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  transition:background var(--t-fast),transform var(--ease-spring) var(--t-base);
}
.prod-add-btn:hover{background:var(--gold);color:var(--navy);transform:scale(1.12) rotate(90deg)}

/* ── Grid-style product card ── */
.prod-grid-card{
  background:var(--white);
  border-radius:var(--r-md);
  overflow:hidden;
  border:1.5px solid var(--cream-2);
  transition:transform var(--t-base) var(--ease),
             border-color var(--t-base),
             box-shadow var(--t-base);
  cursor:pointer;
  position:relative;
}
.prod-grid-card:hover{transform:translateY(-5px);border-color:rgba(200,168,75,.4);box-shadow:var(--shadow-md)}
.prod-grid-card .prod-card-img{height:260px}
.prod-grid-card .prod-card-actions{opacity:0;transform:translateX(-8px)}
.prod-grid-card:hover .prod-card-actions{opacity:1;transform:none}

/* ═══════════════════════════════════════════════
   CATEGORY MOSAIC
═══════════════════════════════════════════════ */
.cat-section{padding:4rem 0;background:var(--cream)}
.cat-mosaic{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(140px,1fr));
  gap:.75rem;
}
.cat-tile{
  background:var(--white);
  border-radius:var(--r-md);
  padding:1.5rem 1rem;
  text-align:center;
  border:1.5px solid var(--cream-2);
  cursor:pointer;
  transition:transform var(--t-base) var(--ease),
             border-color var(--t-base),
             box-shadow var(--t-base);
  position:relative;overflow:hidden;
}
.cat-tile::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,transparent,rgba(200,168,75,.07));
  opacity:0;transition:opacity var(--t-base);
}
.cat-tile:hover{transform:translateY(-4px);border-color:var(--gold);box-shadow:var(--shadow-gold)}
.cat-tile:hover::before{opacity:1}
.cat-tile:hover .cat-icon{transform:scale(1.2) rotate(-8deg)}
.cat-icon{font-size:2rem;display:block;margin-bottom:.5rem;transition:transform var(--t-base) var(--ease)}
.cat-name{font-size:.82rem;font-weight:700;color:var(--navy)}
.cat-count{font-size:.7rem;color:var(--text-soft);margin-top:3px}

/* ═══════════════════════════════════════════════
   CURATED SECTIONS
═══════════════════════════════════════════════ */
.curated-section{padding:4rem 0;background:var(--white)}
.curated-section:nth-child(even){background:var(--cream)}
.curated-header{
  display:flex;align-items:flex-end;justify-content:space-between;
  margin-bottom:2rem;
}
.see-all-link{
  font-size:.85rem;font-weight:700;color:var(--gold-dark);
  padding:8px 18px;border-radius:var(--r-full);
  border:1.5px solid rgba(200,168,75,.4);
  transition:background var(--t-fast),color var(--t-fast);
}
.see-all-link:hover{background:var(--gold);color:var(--navy)}
.products-row{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:1rem;
}

/* ═══════════════════════════════════════════════
   FLASH DEALS
═══════════════════════════════════════════════ */
.flash-section{
  padding:4rem 0;
  background:var(--flash-bg);
  position:relative;overflow:hidden;
}
.flash-section::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 70% 80% at 50% 50%,rgba(255,107,53,.08),transparent);
}
.flash-section-header{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:2.5rem;flex-wrap:wrap;gap:1rem;
  position:relative;
}
.flash-timer-lg{
  display:flex;align-items:center;gap:8px;
  color:rgba(255,255,255,.8);font-size:.8rem;
}
.timer-block-lg{
  background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);
  border-radius:8px;padding:8px 12px;text-align:center;min-width:52px;
}
.timer-block-lg span{display:block;font-size:1.3rem;font-weight:900;color:#fff;line-height:1}
.timer-block-lg small{font-size:.6rem;color:rgba(255,255,255,.5)}
.flash-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:1rem;
  position:relative;
}
.flash-card{
  background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.1);
  border-radius:var(--r-md);
  overflow:hidden;
  cursor:pointer;
  transition:transform var(--t-base) var(--ease),border-color var(--t-base);
}
.flash-card:hover{transform:translateY(-5px);border-color:rgba(255,107,53,.4)}
.flash-card-img{height:200px;overflow:hidden;position:relative}
.flash-card-img img{width:100%;height:100%;object-fit:cover;transition:transform var(--t-slow)}
.flash-card:hover .flash-card-img img{transform:scale(1.06)}
.flash-discount-badge{
  position:absolute;top:10px;right:10px;
  background:var(--flash-accent);color:#fff;
  font-size:.68rem;font-weight:800;
  padding:3px 10px;border-radius:var(--r-full);
}
.flash-card-body{padding:1rem}
.flash-card-name{font-size:.88rem;font-weight:700;color:rgba(255,255,255,.9);margin-bottom:.5rem}
.flash-card-prices{display:flex;align-items:center;gap:8px;margin-bottom:.75rem}
.flash-card-new{font-size:1rem;font-weight:900;color:var(--gold-light)}
.flash-card-old{font-size:.78rem;color:rgba(255,255,255,.35);text-decoration:line-through}
.flash-progress{height:4px;background:rgba(255,255,255,.1);border-radius:2px;margin-bottom:.5rem;overflow:hidden}
.flash-progress-bar{height:100%;background:linear-gradient(90deg,var(--flash-accent),#FFB347);border-radius:2px;transition:width 1s}
.flash-stock-text{font-size:.7rem;color:rgba(255,255,255,.4)}

/* ═══════════════════════════════════════════════
   ALL PRODUCTS
═══════════════════════════════════════════════ */
.all-products-section{padding:4rem 0;background:var(--cream)}
.filter-bar{
  display:flex;gap:8px;flex-wrap:wrap;
  margin-bottom:2rem;
}
.filter-chip{
  padding:8px 20px;border-radius:var(--r-full);
  border:1.5px solid var(--cream-2);
  background:var(--white);
  font-size:.82rem;font-weight:700;
  color:var(--text-mid);
  font-family:var(--font);
  transition:all var(--t-fast);
  cursor:pointer;
}
.filter-chip:hover{border-color:var(--gold);color:var(--gold-dark)}
.filter-chip.active{background:var(--navy);border-color:var(--navy);color:#fff}
.products-masonry{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(230px,1fr));
  gap:1.25rem;
}

/* ═══════════════════════════════════════════════
   NEWSLETTER
═══════════════════════════════════════════════ */
.newsletter{
  padding:5rem 0;
  background:var(--navy);
  position:relative;overflow:hidden;
}
.newsletter-mesh{position:absolute;inset:0;pointer-events:none}
.newsletter-inner{
  display:flex;align-items:center;
  gap:4rem;flex-wrap:wrap;
  position:relative;z-index:1;
}
.newsletter-text{flex:1;min-width:260px}
.newsletter-text h2{font-size:clamp(1.4rem,3.5vw,2rem);font-weight:900;color:#fff;line-height:1.3;margin-bottom:.5rem}
.newsletter-text p{color:rgba(255,255,255,.55)}
.newsletter-form{
  display:flex;gap:10px;flex:1;min-width:280px;flex-wrap:wrap;
}
.nl-input{
  flex:1;min-width:200px;padding:13px 20px;
  border-radius:var(--r-full);
  border:1.5px solid rgba(200,168,75,.3);
  background:rgba(255,255,255,.07);
  color:#fff;font-size:.9rem;outline:none;
  transition:border-color var(--t-fast),background var(--t-fast);
}
.nl-input::placeholder{color:rgba(255,255,255,.35)}
.nl-input:focus{border-color:var(--gold);background:rgba(255,255,255,.1)}

/* ═══════════════════════════════════════════════
   FOOTER
═══════════════════════════════════════════════ */
.footer{background:var(--navy);border-top:1px solid rgba(255,255,255,.07)}
.footer-grid{
  display:grid;
  grid-template-columns:2fr 1fr 1fr 1fr;
  gap:2.5rem;
  padding:3.5rem 0;
}
.footer-brand{}
.footer-logo{display:flex;flex-direction:column;line-height:1;gap:2px;margin-bottom:1rem}
.footer-logo .logo-ar{font-size:1.4rem;color:#fff}
.footer-brand p{font-size:.85rem;color:rgba(255,255,255,.5);line-height:1.7;max-width:220px}
.footer-social{display:flex;gap:8px;margin-top:1.25rem}
.social-btn{
  width:36px;height:36px;
  border-radius:50%;
  background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.1);
  display:flex;align-items:center;justify-content:center;
  color:rgba(255,255,255,.5);
  transition:background var(--t-fast),color var(--t-fast),border-color var(--t-fast);
}
.social-btn:hover{background:var(--gold);color:var(--navy);border-color:var(--gold)}
.footer-col h4{color:#fff;font-weight:700;margin-bottom:1rem;font-size:.9rem}
.footer-col{display:flex;flex-direction:column;gap:.5rem}
.footer-col a{font-size:.83rem;color:rgba(255,255,255,.45);transition:color var(--t-fast)}
.footer-col a:hover{color:var(--gold-light)}
.pay-methods{display:flex;flex-wrap:wrap;gap:6px;margin-top:.25rem}
.pay-chip{
  padding:4px 10px;
  background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.1);
  border-radius:6px;
  font-size:.72rem;font-weight:600;
  color:rgba(255,255,255,.5);
}
.footer-bottom{border-top:1px solid rgba(255,255,255,.07);padding:1.25rem 0}
.footer-bottom-inner{
  display:flex;align-items:center;justify-content:space-between;
  flex-wrap:wrap;gap:8px;
  font-size:.8rem;color:rgba(255,255,255,.3);
}
.footer-bottom-inner a{color:rgba(255,255,255,.3);transition:color var(--t-fast);margin-right:1.5rem}
.footer-bottom-inner a:hover{color:var(--gold-light)}

/* ═══════════════════════════════════════════════
   CART DRAWER
═══════════════════════════════════════════════ */
.drawer-overlay{
  position:fixed;inset:0;
  background:rgba(0,0,0,.5);
  z-index:1200;
  opacity:0;pointer-events:none;
  transition:opacity var(--t-base);
  backdrop-filter:blur(4px);
}
.drawer-overlay.open{opacity:1;pointer-events:all}

.cart-drawer{
  position:fixed;
  top:0;left:0;
  width:min(420px,100vw);height:100%;
  background:var(--white);
  z-index:1201;
  display:flex;flex-direction:column;
  box-shadow:var(--shadow-lg);
  transform:translateX(-100%);
  transition:transform var(--t-slow) var(--ease);
}
.cart-drawer.open{transform:none}

.drawer-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:1.25rem 1.5rem;
  border-bottom:1px solid var(--cream-2);
}
.drawer-header h2{font-size:1.1rem;font-weight:900}
.cart-count-label{font-size:.8rem;color:var(--text-soft);font-weight:500;margin-top:2px;display:block}
.drawer-close{
  width:36px;height:36px;
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  color:var(--text-soft);
  transition:background var(--t-fast),color var(--t-fast);
}
.drawer-close:hover{background:var(--cream-2);color:var(--navy)}

.cart-body{flex:1;overflow-y:auto;padding:1rem}
.cart-empty-state{
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  height:100%;gap:1rem;text-align:center;
  color:var(--text-soft);
}
.cart-empty-state p{font-size:.95rem;font-weight:500}

.cart-item-card{
  display:flex;gap:.875rem;
  padding:.875rem;
  border-radius:var(--r-md);
  border:1.5px solid var(--cream-2);
  margin-bottom:.75rem;
  transition:border-color var(--t-fast);
  animation:slideInCart .25s var(--ease);
}
@keyframes slideInCart{from{opacity:0;transform:translateX(-16px)}to{opacity:1;transform:none}}
.cart-item-card:hover{border-color:rgba(200,168,75,.4)}
.cart-item-img{
  width:72px;height:72px;
  object-fit:cover;border-radius:var(--r-sm);
  background:var(--cream);flex-shrink:0;
}
.cart-item-info{flex:1}
.cart-item-name{font-size:.88rem;font-weight:700;color:var(--navy);margin-bottom:.25rem;line-height:1.3}
.cart-item-variant{font-size:.72rem;color:var(--text-soft)}
.cart-item-price{font-size:.9rem;font-weight:900;color:var(--gold-dark);margin-top:.25rem}
.cart-item-row{display:flex;align-items:center;justify-content:space-between;margin-top:.5rem}
.qty-control{display:flex;align-items:center;border:1.5px solid var(--cream-2);border-radius:var(--r-full);overflow:hidden}
.qty-btn{
  width:28px;height:28px;
  display:flex;align-items:center;justify-content:center;
  font-size:1rem;font-weight:700;
  color:var(--navy);
  transition:background var(--t-fast);
}
.qty-btn:hover{background:var(--cream-2)}
.qty-num{
  width:28px;text-align:center;
  font-weight:800;font-size:.88rem;
  color:var(--navy);
}
.cart-item-remove{
  font-size:.75rem;color:var(--text-soft);
  padding:3px 8px;border-radius:6px;
  transition:color var(--t-fast),background var(--t-fast);
}
.cart-item-remove:hover{color:#EF4444;background:rgba(239,68,68,.08)}

.cart-footer-panel{
  padding:1.25rem 1.5rem;
  border-top:1px solid var(--cream-2);
  display:flex;flex-direction:column;gap:.75rem;
  background:var(--cream);
}
.cart-summary{display:flex;flex-direction:column;gap:.5rem;margin-bottom:.5rem}
.cart-summary-row{display:flex;justify-content:space-between;font-size:.88rem;color:var(--text-mid)}
.cart-summary-row strong{color:var(--navy);font-weight:800}
.total-row{border-top:1px solid var(--cream-2);padding-top:.5rem;margin-top:.25rem}
.total-row span,.total-row strong{font-size:1rem;font-weight:900;color:var(--navy)}

/* ═══════════════════════════════════════════════
   QUICK VIEW DRAWER
═══════════════════════════════════════════════ */
.qv-drawer{
  position:fixed;
  top:0;right:0;
  width:min(500px,100vw);height:100%;
  background:var(--white);
  z-index:1201;
  display:flex;flex-direction:column;
  box-shadow:var(--shadow-lg);
  transform:translateX(100%);
  transition:transform var(--t-slow) var(--ease);
}
.qv-drawer.open{transform:none}
.qv-body{flex:1;overflow-y:auto;padding:1.5rem}

.qv-img{
  width:100%;aspect-ratio:4/3;
  object-fit:cover;border-radius:var(--r-md);
  margin-bottom:1.25rem;
  background:var(--cream);
}
.qv-thumbs{display:flex;gap:8px;margin-bottom:1.25rem}
.qv-thumb{
  width:64px;height:64px;
  object-fit:cover;border-radius:var(--r-sm);
  border:2px solid var(--cream-2);cursor:pointer;
  transition:border-color var(--t-fast);
}
.qv-thumb.active,.qv-thumb:hover{border-color:var(--gold)}
.qv-cat{font-size:.72rem;font-weight:700;color:var(--gold-dark);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.4rem}
.qv-name{font-size:1.2rem;font-weight:900;color:var(--navy);line-height:1.3;margin-bottom:.6rem}
.qv-rating{display:flex;align-items:center;gap:6px;margin-bottom:1rem;font-size:.85rem}
.qv-stars{color:var(--gold)}
.qv-rating-count{color:var(--text-soft)}
.qv-desc{font-size:.88rem;color:var(--text-mid);line-height:1.7;margin-bottom:1.25rem}
.qv-price-block{margin-bottom:1.25rem}
.qv-price-now{font-size:1.5rem;font-weight:900;color:var(--navy)}
.qv-price-was{font-size:.9rem;color:var(--text-soft);text-decoration:line-through;margin-right:8px}
.qv-discount{background:#FFF0E8;color:var(--flash-accent);font-size:.72rem;font-weight:800;padding:3px 10px;border-radius:var(--r-full)}
.qv-variants{margin-bottom:1.25rem}
.qv-variant-label{font-size:.82rem;font-weight:700;margin-bottom:.5rem;color:var(--navy)}
.qv-variant-options{display:flex;gap:8px;flex-wrap:wrap}
.qv-variant-btn{
  padding:6px 16px;border-radius:var(--r-full);
  border:1.5px solid var(--cream-2);
  font-size:.8rem;font-weight:700;
  font-family:var(--font);color:var(--text-mid);
  background:var(--white);cursor:pointer;
  transition:all var(--t-fast);
}
.qv-variant-btn:hover,.qv-variant-btn.active{border-color:var(--navy);color:var(--navy);background:var(--cream)}
.qv-actions{display:flex;gap:10px;margin-top:1.25rem}
.qv-qty{display:flex;align-items:center;border:1.5px solid var(--cream-2);border-radius:var(--r-full);overflow:hidden;flex-shrink:0}
.qv-qty-btn{width:38px;height:42px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;font-weight:700;transition:background var(--t-fast)}
.qv-qty-btn:hover{background:var(--cream-2)}
.qv-qty-num{width:36px;text-align:center;font-weight:800;font-size:.95rem;background:none;border:none;color:var(--navy);font-family:var(--font)}
.qv-add-btn{flex:1}
.qv-view-btn{flex-shrink:0}

/* ═══════════════════════════════════════════════
   TOAST
═══════════════════════════════════════════════ */
.toast-stack{
  position:fixed;bottom:1.5rem;right:1.5rem;
  z-index:2000;display:flex;flex-direction:column;gap:8px;
  pointer-events:none;
}
.toast{
  display:flex;align-items:center;gap:10px;
  padding:12px 18px;
  background:var(--navy);color:#fff;
  border-radius:var(--r-md);
  box-shadow:var(--shadow-lg);
  font-size:.875rem;font-weight:600;
  animation:toastPop .35s var(--ease-spring);
  pointer-events:all;
  min-width:240px;
  border:1px solid rgba(200,168,75,.2);
}
.toast.success{border-color:rgba(16,185,129,.3)}
.toast.fadeOut{animation:toastFade .3s ease forwards}
@keyframes toastPop{from{opacity:0;transform:translateY(12px) scale(.9)}to{opacity:1;transform:none}}
@keyframes toastFade{to{opacity:0;transform:translateY(8px)}}

/* Back to top */
.back-top{
  position:fixed;bottom:1.5rem;left:1.5rem;
  width:44px;height:44px;
  background:var(--navy);color:var(--gold-light);
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  box-shadow:var(--shadow-md);
  border:1.5px solid rgba(200,168,75,.3);
  opacity:0;pointer-events:none;
  transition:all var(--t-base);z-index:500;
}
.back-top.show{opacity:1;pointer-events:all}
.back-top:hover{background:var(--gold);color:var(--navy);transform:translateY(-3px)}

/* ═══════════════════════════════════════════════
   ANIMATIONS
═══════════════════════════════════════════════ */
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
.fade-up{animation:fadeUp .6s var(--ease) both}
.fade-up-1{animation-delay:.08s}
.fade-up-2{animation-delay:.16s}
.fade-up-3{animation-delay:.24s}
.fade-up-4{animation-delay:.32s}

/* ═══════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════ */
@media(max-width:1100px){
  .bento-brand{grid-column:span 7}
  .bento-product-hero{grid-column:span 5}
  .bento-flash{grid-column:span 4}
  .bento-stats{grid-column:span 4}
  .bento-product-sm{grid-column:span 4}
  .bento-trust{grid-column:span 7;display:none}
  .footer-grid{grid-template-columns:1fr 1fr}
}

@media(max-width:900px){
  .nav-links{display:none}
  .hamburger{display:flex}
  :root{--nav-h:60px;--top-h:32px}

  .bento-container{grid-template-columns:1fr 1fr;gap:.75rem}
  .bento-brand{grid-column:span 2;min-height:360px}
  .bento-product-hero{grid-column:span 1;grid-row:span 1;min-height:280px}
  .bento-flash{grid-column:span 1}
  .bento-stats{grid-column:span 2;flex-direction:row}
  .bento-product-sm{grid-column:span 1}
  .bento-trust{display:none}

  .curated-header{flex-direction:column;align-items:flex-start;gap:1rem}
  .flash-section-header{flex-direction:column;align-items:flex-start}
  .newsletter-inner{flex-direction:column;gap:2rem}
  .footer-grid{grid-template-columns:1fr 1fr;gap:2rem}
  
  /* 2026 Bottom Mobile Navigation */
  .mobile-bottom-nav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: rgba(15, 15, 15, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 999;
    padding: 0.5rem 1rem;
    padding-bottom: calc(0.5rem + env(safe-area-inset-bottom)); /* For iPhone Home Indicator */
  }
}

@media(max-width:600px){
  .bento-container{grid-template-columns:1fr;gap:.75rem}
  .bento-brand{grid-column:span 1;min-height:320px}
  .bento-product-hero{grid-column:span 1;min-height:260px}
  .bento-flash{grid-column:span 1}
  .bento-stats{grid-column:span 1}
  .bento-product-sm{grid-column:span 1;min-height:160px}

  .bento-brand-title{font-size:2rem}
  .bento-brand{padding:1.75rem}

  .h-scroll-track{padding:0.5rem 1rem 1rem}
  .footer-grid{grid-template-columns:1fr}
  .footer-col:nth-child(3),.footer-col:nth-child(4){display:none}

  .qv-drawer{width:100vw}
  .cart-drawer{width:100vw}
}

/* Scroll snap for mobile */
@media(max-width:768px){
  .products-row{
    display:flex;overflow-x:auto;gap:1rem;
    scroll-snap-type:x mandatory;
    padding-bottom:.5rem;
    scrollbar-width:none;
  }
  .products-row::-webkit-scrollbar{display:none}
  .products-row .prod-grid-card{
    flex-shrink:0;width:200px;
    scroll-snap-align:start;
  }
}

/* ══════════════════════════════════════
   FARAH STORE 2026/2027 OVERRIDES
   Ultra-Minimalism & Neo-Glassmorphism
══════════════════════════════════════ */

/* Typography & Spacing */
h1, h2, h3, h4, h5, h6 {
  font-family: 'Cairo', sans-serif !important;
  font-weight: 900 !important;
  letter-spacing: -0.03em;
  line-height: 1.1;
  color: var(--navy);
}

.section-heading {
  font-size: 2.5rem !important;
  margin-bottom: 3rem !important;
}

body {
  background-color: var(--cream) !important;
  padding-bottom: 90px;
}

/* Floating Glassmorphism Cards (Bento) */
.bento-card {
  background: var(--glass-bg);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid var(--glass-border) !important;
  border-radius: 28px !important;
  box-shadow: var(--glass-shadow) !important;
  transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), border 0.3s ease !important;
}

.bento-card:hover {
  transform: translateY(-6px) scale(1.01) !important;
  box-shadow: var(--glass-shadow-hover) !important;
  border: 1px solid rgba(216, 154, 131, 0.3) !important; /* Gold hint on hover */
  z-index: 10;
}

/* Fix specific cards for desktop */
.bento-brand {
  background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,255,255,0.4)) !important;
}
.bento-brand-title { color: var(--navy) !important; }
.bento-brand-title em { color: var(--gold) !important; }

@media (min-width: 769px) {
  .nav-links { gap: 2rem !important; }
  .navbar { height: 85px !important; }
}

/* 2026 Bottom Mobile Navigation */
.mobile-bottom-nav {
  display: none;
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  width: 92%;
  max-width: 420px;
  height: 75px;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(40px) saturate(200%);
  -webkit-backdrop-filter: blur(40px) saturate(200%);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 100px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.12);
  z-index: 9999;
  justify-content: space-between;
  align-items: center;
  padding: 0 25px;
}

@media (max-width: 768px) {
  .navbar, .topbar { display: none !important; }
  .mobile-bottom-nav { display: flex; }
}

.mobile-bottom-nav a {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-soft);
  text-decoration: none;
  font-size: 0.75rem;
  font-weight: 700;
  gap: 6px;
  transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  position: relative;
}

.mobile-bottom-nav a.active {
  color: var(--navy);
  transform: translateY(-5px);
}

.mobile-bottom-nav a svg {
  width: 26px;
  height: 26px;
  stroke-width: 2.2;
}

.cart-badge-bottom {
  position: absolute;
  top: -8px;
  right: -8px;
  background: var(--flash-accent);
  color: #fff;
  font-size: 0.7rem;
  font-weight: 900;
  min-width: 20px;
  height: 20px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #fff;
}

/* Scroll Reveal Micro-Animations */
.reveal {
  opacity: 0;
  transform: translateY(60px) scale(0.96);
  transition: all 1s cubic-bezier(0.25, 1, 0.5, 1);
}
.reveal.active {
  opacity: 1;
  transform: translateY(0) scale(1);
}
/* Animated Brand Text Overlay */
.animated-brand-text {
  font-size: 3.5rem !important;
  color: #fff !important;
  line-height: 1.1;
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: 2px;
  position: relative;
  text-shadow: 0 4px 20px rgba(0,0,0,0.5);
}

.animated-brand-text span {
  display: block;
  background: linear-gradient(45deg, #fff, var(--gold-light), #fff);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-size: 200% auto;
  animation: shine 4s linear infinite;
}

.brand-ar { font-family: 'Cairo', sans-serif; font-weight: 900; font-size: 4rem; }
.brand-en { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-weight: 300; font-size: 1.5rem; letter-spacing: 8px; opacity: 0.9; margin-top: -5px; }

@keyframes shine {
  to { background-position: 200% center; }
}

#mute-toggle-btn:hover { background: rgba(255,255,255,0.4) !important; transform: scale(1.1); }
